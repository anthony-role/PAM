rules_version = '2';

// Règles de sécurité de la base PAM.
// - Tout le monde peut consulter les résultats.
// - Seules les adresses Google listées dans le document config/acces (champ "emails")
//   peuvent créer ou modifier des éditions et des joueurs.
// - Le document config/acces ne se modifie que depuis la console Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function estJoueur() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/config/acces).data.emails;
    }

    match /editions/{annee} {
      allow read: if true;
      allow create, update: if estJoueur();
      allow delete: if false;
    }

    match /joueurs/{id} {
      allow read: if true;
      allow create, update: if estJoueur();
      allow delete: if false;
    }

    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
