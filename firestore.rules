rules_version = '2';

// Regles de securite de la base PAM (version simple, sans compte ni code).
// - Tout le monde peut consulter les resultats.
// - Tout le monde peut creer un evenement et saisir les resultats.
// - Personne ne peut supprimer un evenement ou un joueur depuis le site.
// - Garde-fous : un evenement s'appelle par son annee (2000 a 2100) et reste de taille raisonnable.
service cloud.firestore {
  match /databases/{database}/documents {

    match /editions/{annee} {
      allow read: if true;
      allow create, update: if annee.matches('^20[0-9][0-9]$|^2100$')
        && request.resource.data.size() < 30;
      allow delete: if false;
    }

    match /joueurs/{id} {
      allow read: if true;
      allow create, update: if id.size() <= 30
        && request.resource.data.size() < 10;
      allow delete: if false;
    }

    match /{autre=**} {
      allow read, write: if false;
    }
  }
}
